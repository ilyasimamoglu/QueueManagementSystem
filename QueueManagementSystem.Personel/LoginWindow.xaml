<Window x:Class="QueueManagementSystem.Counter.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sisteme Giriş - Gişe Pro" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Ana Arka Plan ve Çerçeve -->
    <Border Background="#0F172A" CornerRadius="16" BorderBrush="#334155" BorderThickness="1" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Kapat Butonu -->
            <Button Grid.Row="0" Content="✕" HorizontalAlignment="Right" Foreground="#94A3B8" Background="Transparent" BorderThickness="0" FontSize="16" Cursor="Hand" Click="BtnClose_Click"/>

            <!-- Logo ve Başlık -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,10,0,30">
                <TextBlock Text="🏢" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="GİŞE YÖNETİM" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                <TextBlock Text="Sistem Girişi" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Form Alanı -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                <TextBlock Text="Kullanıcı Adı" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,5"/>
                <TextBox x:Name="txtUsername" FontSize="14" Padding="12" Background="#1E293B" Foreground="#F8FAFC" BorderThickness="0" Margin="0,0,0,20"/>

                <TextBlock Text="Şifre" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtPassword" FontSize="14" Padding="12" Background="#1E293B" Foreground="#F8FAFC" BorderThickness="0" Margin="0,0,0,30"/>

                <!-- YENİ: IsDefault="True" eklendi -->
                <Button x:Name="btnLogin" IsDefault="True" Style="{StaticResource RoundedButton}" Content="Sisteme Giriş Yap" Background="#3B82F6" Foreground="White" FontWeight="Bold" FontSize="14" Padding="0,15" BorderThickness="0" Cursor="Hand" Click="BtnLogin_Click"/>
            </StackPanel>

            <!-- Alt Bilgi -->
            <TextBlock Grid.Row="3" Text="v2.1.0 Enterprise Edition" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,30,0,0"/>
        </Grid>
    </Border>
</Window>
<Window x:Class="QueueManagementSystem.Counter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gişe Terminali - Pro" Height="760" Width="1200" WindowStartupLocation="CenterScreen" 
        Background="#0F172A" MinWidth="1000" MinHeight="700" FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Storyboard x:Key="BlinkAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="brdWaitingCard" Storyboard.TargetProperty="Opacity" From="1.0" To="0.4" Duration="0:0:0.6" AutoReverse="True" />
        </Storyboard>

        <Style x:Key="RoundedButton8" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedButton12" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ANA DASHBOARD EKRANI -->
        <Grid x:Name="pnlMainViewbox" Visibility="Visible" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Üst Bar: Başlık ve Sistem Durumu (Ayarlar butonu KALDIRILDI) -->
            <Grid Grid.Row="0" Margin="0,0,0,25">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="GİŞE" FontSize="28" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,10,0"/>
                    <ComboBox x:Name="cmbCounterId" Width="70" FontSize="20" FontWeight="Bold" Background="White" Foreground="#0F172A" BorderThickness="0" Padding="5,2" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Sadece sistemin online/offline durumunu gösteren bilgi kartı bırakıldı -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Background="#1E293B" CornerRadius="8" Padding="15,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="API 🟢" Foreground="#F8FAFC" FontSize="12" Margin="0,0,15,0" ToolTip="Online"/>
                            <TextBlock Text="DB 🟢" Foreground="#F8FAFC" FontSize="12" Margin="0,0,15,0" ToolTip="Online"/>
                            <TextBlock x:Name="txtArdStatusMini" Text="Ard 🔴" Foreground="#F8FAFC" FontSize="12" Margin="0,0,15,0" ToolTip="Bağlı Değil"/>
                            <TextBlock Text="Yazıcı 🟢" Foreground="#F8FAFC" FontSize="12" ToolTip="Hazır"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 3'lü İstatistik Kartları -->
            <Grid Grid.Row="1" Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#1E293B" CornerRadius="16" Padding="20">
                    <StackPanel>
                        <TextBlock Text="📊 TOPLAM ÇAĞRI" FontSize="12" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="txtTotalCalled" Text="0" FontSize="28" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#1E293B" CornerRadius="16" Padding="20">
                    <StackPanel>
                        <TextBlock Text="⏱️ İŞLEM SÜRESİ" FontSize="12" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="txtProcessTime" Text="00:00" FontSize="28" FontWeight="Bold" Foreground="#3B82F6" FontFamily="Consolas" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="brdWaitingCard" Grid.Column="4" Background="#1E293B" CornerRadius="16" Padding="20">
                    <StackPanel>
                        <TextBlock Text="👥 SIRADA BEKLEYEN" FontSize="12" FontWeight="Bold" Foreground="#94A3B8"/>
                        <TextBlock x:Name="txtTotalWaiting" Text="0" FontSize="28" FontWeight="Bold" Foreground="#F59E0B" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Ana İşlem Alanı ve Kuyruk Listesi -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6.5*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="3.5*"/>
                </Grid.ColumnDefinitions>

                <!-- Sol: Bilet Çağırma Ekranı -->
                <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="30">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="ŞU AN İŞLEM GÖREN" FontSize="16" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center"/>

                        <Viewbox Grid.Row="1" Margin="0,20">
                            <TextBlock x:Name="txtCurrentTicket" Text="---" FontWeight="Black" Foreground="#0F172A"/>
                        </Viewbox>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnCallNext" Style="{StaticResource RoundedButton12}" Grid.Column="0" Background="#3B82F6" Foreground="White" BorderThickness="0" Padding="0,20" Cursor="Hand" Click="BtnCallNext_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📢" FontSize="22" Margin="0,0,10,0"/>
                                    <TextBlock Text="Sıradaki Müşteri" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnComplete" Style="{StaticResource RoundedButton12}" Grid.Column="2" Background="#10B981" Foreground="White" BorderThickness="0" Padding="0,20" Cursor="Hand" Click="BtnComplete_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✅" FontSize="22" Margin="0,0,10,0"/>
                                    <TextBlock Text="İşlemi Tamamla" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Sağ: Bekleyen Müşteriler Listesi -->
                <Border Grid.Column="2" Background="#1E293B" CornerRadius="16" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="MÜŞTERİ KUYRUĞU" FontSize="14" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,15"/>

                        <ListView x:Name="lstWaitingCustomers" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#334155" CornerRadius="8" Padding="15,10" Margin="0,0,0,8" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListView}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="👤 Bilet No: " Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding TicketNumber}" Foreground="#F8FAFC"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
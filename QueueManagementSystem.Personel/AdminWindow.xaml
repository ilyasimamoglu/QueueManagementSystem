<Window x:Class="QueueManagementSystem.Counter.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yönetim Paneli - Gişe Pro" Height="800" Width="1300" WindowStartupLocation="CenterScreen" 
        Background="#0F172A" MinWidth="1100" MinHeight="750" FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#0F172A"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1E293B"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="White"/>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="RoundedButton8" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#94A3B8" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#0F172A" BorderThickness="1" BorderBrush="#334155" CornerRadius="0,0,5,5"/>
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="#0F172A" Padding="12,10" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="#1E293B"/>
            <Setter Property="AlternatingRowBackground" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="40"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SOL BÖLÜM: Ana Admin Menüsü -->
        <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="25,30,25,30">
                    <TextBlock Text="🏢" FontSize="36" Margin="0,0,0,10"/>
                    <TextBlock Text="KOMUTA MERKEZİ" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Sistem Yöneticisi" FontSize="12" Foreground="#3B82F6"/>
                </StackPanel>

                <ListBox x:Name="lstAdminMenu" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#94A3B8" SelectedIndex="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="25,15"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#3B82F6"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Content="📊 Dashboard"/>
                    <ListBoxItem Content="👥 Kullanıcı Yönetimi"/>
                    <ListBoxItem Content="📈 Raporlar"/>
                    <ListBoxItem Content="🏅 Personel Performansı"/>
                    <ListBoxItem Content="⚙️ Sistem Ayarları"/>
                </ListBox>

                <Button Grid.Row="2" Style="{StaticResource RoundedButton8}" Content="🚪 Güvenli Çıkış" Background="#EF4444" Foreground="White" Padding="15" Margin="25,20,25,30" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnLogout_Click"/>
            </Grid>
        </Border>

        <!-- SAĞ BÖLÜM: Seçilen Menüye Göre Değişen İçerik -->
        <Grid Grid.Column="1">
            <TabControl Background="Transparent" BorderThickness="0" SelectedIndex="{Binding ElementName=lstAdminMenu, Path=SelectedIndex}">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- 0: DASHBOARD -->
                <TabItem>
                    <Grid Margin="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- ÜST BİLGİ VE SAAT -->
                        <Grid Grid.Row="0" Margin="0,0,0,25">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Sistem Durumu: " FontSize="14" Foreground="#94A3B8"/>
                                <TextBlock Text="Tüm Servisler Aktif 🟢" FontSize="14" FontWeight="Bold" Foreground="#10B981"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="txtCurrentDate" Text="00.00.0000" FontSize="14" Foreground="#94A3B8" Margin="0,0,10,0"/>
                                <TextBlock x:Name="txtCurrentTime" Text="00:00:00" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" FontFamily="Consolas" Margin="0,0,20,0"/>
                                <Border Width="1" Background="#334155" Margin="0,0,20,0" Height="20"/>
                                <TextBlock Text="Hoş Geldiniz, " FontSize="14" Foreground="#94A3B8"/>
                                <TextBlock x:Name="txtAdminName" Text="Yükleniyor..." FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,25">
                            <Border Background="#1E293B" CornerRadius="12" Padding="20" Margin="0,0,15,0">
                                <StackPanel>
                                    <TextBlock Text="BUGÜNKÜ MÜŞTERİ" FontSize="12" FontWeight="Bold" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="txtTotalCustomers" Text="0" FontSize="32" FontWeight="Bold" Foreground="#3B82F6" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1E293B" CornerRadius="12" Padding="20" Margin="0,0,15,0">
                                <StackPanel>
                                    <TextBlock Text="AKTİF GİŞE / TOPLAM" FontSize="12" FontWeight="Bold" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="txtActiveCounters" Text="0 / 5" FontSize="32" FontWeight="Bold" Foreground="#10B981" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1E293B" CornerRadius="12" Padding="20" Margin="0,0,15,0">
                                <StackPanel>
                                    <TextBlock Text="ŞU AN BEKLEYEN" FontSize="12" FontWeight="Bold" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="txtWaitingCustomers" Text="0" FontSize="32" FontWeight="Bold" Foreground="#F59E0B" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1E293B" CornerRadius="12" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="ORTALAMA BEKLEME" FontSize="12" FontWeight="Bold" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="txtDashboardAvgWait" Text="00:00" FontSize="32" FontWeight="Bold" Foreground="#F8FAFC" FontFamily="Consolas" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#1E293B" CornerRadius="12" Padding="25">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Haftalık Yoğunluk Grafiği" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,15"/>
                                        <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" ClipToBounds="True" Padding="15">
                                            <Grid>
                                                <UniformGrid Rows="4" Columns="1" Margin="0,0,0,30">
                                                    <Border BorderBrush="#1E293B" BorderThickness="0,0,0,1"/>
                                                    <Border BorderBrush="#1E293B" BorderThickness="0,0,0,1"/>
                                                    <Border BorderBrush="#1E293B" BorderThickness="0,0,0,1"/>
                                                    <Border BorderBrush="#1E293B" BorderThickness="0,0,0,1"/>
                                                </UniformGrid>
                                                <ItemsControl x:Name="icWeeklyChart" Margin="0,0,0,25">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="7"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid VerticalAlignment="Bottom" Height="120" Margin="8,0,8,0">
                                                                <Border Background="{Binding Color}" Height="{Binding Height}" CornerRadius="3,3,0,0" VerticalAlignment="Bottom" ToolTip="{Binding CountText}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl x:Name="icWeeklyLabels" VerticalAlignment="Bottom">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="7"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Label}" Foreground="#94A3B8" HorizontalAlignment="Center" FontSize="11"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2" Background="#1E293B" CornerRadius="12" Padding="25">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Saatlik Yoğunluk (Bugün)" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,15"/>
                                        <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="15">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl x:Name="icHourlyChart">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="45"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Label}" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="12"/>
                                                                <Border Grid.Column="1" Background="{Binding Color}" Height="12" Width="{Binding Width}" CornerRadius="2" HorizontalAlignment="Left" ToolTip="{Binding CountText}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Grid.Column="2" Background="#1E293B" CornerRadius="12" Padding="25">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Hızlı Gişe Yönetimi" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,20"/>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="icCountersStatus">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,5">
                                                            <TextBlock Text="{Binding CounterName}" Foreground="#F8FAFC" VerticalAlignment="Center" FontSize="15" FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <Grid Margin="0,0,0,15">
                                                            <TextBlock Text="{Binding OperatorName}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ServedToday}" Foreground="#3B82F6" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <Border BorderBrush="#334155" BorderThickness="0,0,0,1" Margin="0,0,0,15"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- 1: KULLANICI YÖNETİMİ -->
                <TabItem>
                    <Grid Margin="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="White" Grid.Row="0" Margin="0,0,0,25" Text="Kullanıcı ve Yetki Yönetimi"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="350"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#1E293B" CornerRadius="12" Grid.Column="0" Padding="25">
                                <StackPanel>
                                    <TextBlock x:Name="txtFormTitle" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,25" Text="Yeni Kullanıcı Ekle"/>
                                    <TextBlock FontSize="13" Foreground="#94A3B8" Margin="0,0,0,8" Text="Ad Soyad"/>
                                    <TextBox x:Name="txtFullName" Background="#0F172A" BorderThickness="1" BorderBrush="#334155" FontSize="14" Foreground="#F8FAFC" Margin="0,0,0,15" Padding="12"/>
                                    <TextBlock FontSize="13" Foreground="#94A3B8" Margin="0,0,0,8" Text="Kullanıcı Adı"/>
                                    <TextBox x:Name="txtNewUsername" Background="#0F172A" BorderThickness="1" BorderBrush="#334155" FontSize="14" Foreground="#F8FAFC" Margin="0,0,0,15" Padding="12"/>
                                    <TextBlock FontSize="13" Foreground="#94A3B8" Margin="0,0,0,8" Text="Şifre (Değiştirmek için doldurun)"/>
                                    <PasswordBox x:Name="txtNewPassword" Background="#0F172A" BorderThickness="1" BorderBrush="#334155" FontSize="14" Foreground="#F8FAFC" Margin="0,0,0,15" Padding="12"/>
                                    <TextBlock FontSize="13" FontWeight="Bold" Foreground="#3B82F6" Margin="0,0,0,8" Text="Rol (Yetki)"/>
                                    <ComboBox x:Name="cmbNewUserRole" FontSize="14" Margin="0,0,0,15" SelectedIndex="0">
                                        <ComboBoxItem Content="Gişe Personeli"/>
                                        <ComboBoxItem Content="Admin (Yönetici)"/>
                                    </ComboBox>
                                    <TextBlock FontSize="13" Foreground="#94A3B8" Margin="0,0,0,8" Text="Atanacak Gişe"/>
                                    <ComboBox x:Name="cmbAssignedCounter" FontSize="14" Margin="0,0,0,25" SelectedIndex="0">
                                        <ComboBoxItem Content="Gişe Yok (Admin)"/>
                                        <ComboBoxItem Content="Gişe 1"/>
                                        <ComboBoxItem Content="Gişe 2"/>
                                        <ComboBoxItem Content="Gişe 3"/>
                                        <ComboBoxItem Content="Gişe 4"/>
                                        <ComboBoxItem Content="Gişe 5"/>
                                    </ComboBox>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="btnSaveUser" Click="BtnSaveUser_Click" Grid.Column="0" Background="#3B82F6" BorderThickness="0" Content="➕ Kullanıcı Ekle" Cursor="Hand" FontWeight="Bold" Foreground="White" Padding="15" Style="{StaticResource RoundedButton8}"/>
                                        <Button x:Name="btnCancelEdit" Click="BtnCancelEdit_Click" Grid.Column="1" Visibility="Collapsed" Background="#64748B" BorderThickness="0" Content="✖ İptal" Cursor="Hand" FontWeight="Bold" Foreground="White" Padding="15" Margin="10,0,0,0" Style="{StaticResource RoundedButton8}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Background="#1E293B" CornerRadius="12" Grid.Column="2" Padding="25">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" Grid.Row="0" Margin="0,0,0,20" Text="Sistemdeki Kullanıcılar"/>
                                    <Grid Grid.Row="1" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="Bold" Foreground="#94A3B8" Grid.Column="0" Text="Ad Soyad"/>
                                        <TextBlock FontWeight="Bold" Foreground="#94A3B8" Grid.Column="1" Text="Kullanıcı Adı"/>
                                        <TextBlock FontWeight="Bold" Foreground="#94A3B8" Grid.Column="2" Text="Rol"/>
                                        <TextBlock FontWeight="Bold" Foreground="#94A3B8" Grid.Column="3" Text="Atanan Gişe"/>
                                        <TextBlock FontWeight="Bold" Foreground="#94A3B8" Grid.Column="4" HorizontalAlignment="Center" Text="İşlemler"/>
                                    </Grid>
                                    <Border Background="#334155" Grid.Row="1" Height="1" Margin="0,0,0,-5" VerticalAlignment="Bottom"/>
                                    <ScrollViewer Grid.Row="2" Margin="0,15,0,0" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="icUsers">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,15">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.5*"/>
                                                            <ColumnDefinition Width="1*"/>
                                                            <ColumnDefinition Width="1*"/>
                                                            <ColumnDefinition Width="1*"/>
                                                            <ColumnDefinition Width="110"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                            <TextBlock Margin="0,0,10,0" Text="{Binding Icon}"/>
                                                            <TextBlock FontWeight="Bold" Foreground="White" Text="{Binding FullName}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Foreground="#94A3B8" Grid.Column="1" Text="{Binding Username}" VerticalAlignment="Center"/>
                                                        <TextBlock Foreground="{Binding RoleColor}" FontWeight="Bold" Grid.Column="2" Text="{Binding Role}" VerticalAlignment="Center"/>
                                                        <TextBlock Foreground="#3B82F6" FontWeight="SemiBold" Grid.Column="3" Text="{Binding AssignedCounter}" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Click="BtnEditUser_Click" Tag="{Binding}" Background="#F59E0B" BorderThickness="0" Content="✏️" Cursor="Hand" Foreground="White" Padding="12,6" Margin="0,0,5,0" Style="{StaticResource RoundedButton8}" ToolTip="Düzenle/Şifre Değiştir"/>
                                                            <Button Click="BtnDeleteUser_Click" Tag="{Binding Id}" Background="#EF4444" BorderThickness="0" Content="Sil" Cursor="Hand" Foreground="White" Padding="15,6" Style="{StaticResource RoundedButton8}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- 2: GELİŞMİŞ RAPORLAR -->
                <TabItem>
                    <Grid Margin="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Filtrele" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#F8FAFC"/>
                            <Button Click="BtnFilter_Click" Content="Günlük" Margin="0,5" Padding="12" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" Style="{StaticResource RoundedButton8}"/>
                            <Button Click="BtnFilter_Click" Content="Haftalık" Margin="0,5" Padding="12" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" Style="{StaticResource RoundedButton8}"/>
                            <Button Click="BtnFilter_Click" Content="Aylık" Margin="0,5" Padding="12" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" Style="{StaticResource RoundedButton8}"/>
                            <Button Click="BtnFilter_Click" Content="Yıllık" Margin="0,5" Padding="12" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" Style="{StaticResource RoundedButton8}"/>
                            <TextBlock Text="Dışa Aktar" FontSize="16" FontWeight="Bold" Margin="0,30,0,15" Foreground="#F8FAFC"/>
                            <Button Click="BtnExportExcel_Click" Content="📊 Excel" Margin="0,5" Padding="12" Background="#10B981" Foreground="White" FontWeight="Bold" Style="{StaticResource RoundedButton8}" Cursor="Hand"/>
                            <Button Click="BtnExportPdf_Click" Content="📄 PDF" Margin="0,5" Padding="12" Background="#EF4444" Foreground="White" FontWeight="Bold" Style="{StaticResource RoundedButton8}" Cursor="Hand"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Border Background="#1E293B" Width="220" Height="140" CornerRadius="12" Padding="20" Margin="10" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="En Yoğun Gün" Foreground="#94A3B8" FontSize="14" HorizontalAlignment="Center"/>
                                    <Border BorderBrush="#334155" BorderThickness="0,0,0,1" Margin="0,15"/>
                                    <TextBlock x:Name="txtBusiestDay" Text="Pazartesi" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#F8FAFC"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1E293B" Width="220" Height="140" CornerRadius="12" Padding="20" Margin="10" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Ortalama Bekleme" Foreground="#94A3B8" FontSize="14" HorizontalAlignment="Center"/>
                                    <Border BorderBrush="#334155" BorderThickness="0,0,0,1" Margin="0,15"/>
                                    <TextBlock x:Name="txtAvgWaitTime" Text="03:12" FontSize="26" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1E293B" Width="220" Height="140" CornerRadius="12" Padding="20" Margin="10" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="En Yoğun Saat" Foreground="#94A3B8" FontSize="14" HorizontalAlignment="Center"/>
                                    <Border BorderBrush="#334155" BorderThickness="0,0,0,1" Margin="0,15"/>
                                    <TextBlock x:Name="txtBusiestHour" Text="13:00" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#3B82F6"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </Grid>
                </TabItem>

                <!-- 3: PERSONEL PERFORMANSI -->
                <TabItem>
                    <Grid Margin="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Margin="0,0,0,25">
                            <Border Background="#10B981" CornerRadius="12" Padding="20" Margin="0,0,20,0" Width="280">
                                <StackPanel>
                                    <TextBlock Text="En Verimli Personel" Foreground="White" Opacity="0.9" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock x:Name="txtBestStaffName" Text="Yükleniyor..." Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#3B82F6" CornerRadius="12" Padding="20" Width="280">
                                <StackPanel>
                                    <TextBlock Text="Toplam Hizmet Verilen" Foreground="White" Opacity="0.9" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock x:Name="txtTotalServed" Text="0 Kişi" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <Border Grid.Row="1" Background="#1E293B" CornerRadius="12" Padding="5" BorderBrush="#334155" BorderThickness="1">
                            <DataGrid x:Name="dgPerformance" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Personel Adı" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Baktığı Kişi" Binding="{Binding Served}" Width="150"/>
                                    <DataGridTextColumn Header="Ort. Süre" Binding="{Binding AvgTime}" Width="150"/>
                                    <DataGridTextColumn Header="Mola Süresi" Binding="{Binding BreakTime}" Width="150"/>
                                    <DataGridTextColumn Header="Durum" Binding="{Binding Status}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- 4: SİSTEM AYARLARI -->
                <TabItem>
                    <Grid Background="#0F172A">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,1,0">
                            <ListBox x:Name="lstSettingsMenu" Background="Transparent" BorderThickness="0" Foreground="#94A3B8" Margin="0,20,0,0" SelectedIndex="0">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="25,12"/>
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#3B82F6"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBoxItem Content="🖥️ Sistem Durumu"/>
                                <ListBoxItem Content="🌐 API Ayarları"/>
                                <ListBoxItem Content="🔌 Arduino Donanımı"/>
                                <ListBoxItem Content="🖨 Yazıcı Ayarları"/>
                                <ListBoxItem Content="🗄 Veritabanı"/>
                            </ListBox>
                        </Border>
                        <TabControl Grid.Column="1" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding ElementName=lstSettingsMenu, Path=SelectedIndex}">
                            <TabControl.ItemContainerStyle>
                                <Style TargetType="TabItem">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Style>
                            </TabControl.ItemContainerStyle>
                            <TabItem>
                                <StackPanel Margin="40,30,40,0" HorizontalAlignment="Left" Width="450">
                                    <TextBlock Text="Genel Sistem Durumu" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,25"/>
                                    <Border Background="#1E293B" CornerRadius="12" Padding="25" BorderBrush="#334155" BorderThickness="1">
                                        <StackPanel>
                                            <Grid Margin="0,8">
                                                <TextBlock Text="API Sunucusu" Foreground="#94A3B8" FontSize="15"/>
                                                <TextBlock Text="🟢 Online" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#10B981"/>
                                            </Grid>
                                            <Border BorderBrush="#334155" BorderThickness="0,0,0,1" Margin="0,5"/>
                                            <Grid Margin="0,8">
                                                <TextBlock Text="Veritabanı (SQL)" Foreground="#94A3B8" FontSize="15"/>
                                                <TextBlock Text="🟢 Online" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#10B981"/>
                                            </Grid>
                                            <Border BorderBrush="#334155" BorderThickness="0,0,0,1" Margin="0,5"/>
                                            <Grid Margin="0,8">
                                                <TextBlock Text="Arduino (Donanım)" Foreground="#94A3B8" FontSize="15"/>
                                                <TextBlock Text="🟢 Online" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#10B981"/>
                                            </Grid>
                                            <Border BorderBrush="#334155" BorderThickness="0,0,0,1" Margin="0,5"/>
                                            <Grid Margin="0,8">
                                                <TextBlock Text="Termal Yazıcı" Foreground="#94A3B8" FontSize="15"/>
                                                <TextBlock Text="🟢 Hazır" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#10B981"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </TabItem>
                            <TabItem>
                                <StackPanel Margin="40,30,40,0" HorizontalAlignment="Left" Width="450">
                                    <TextBlock Text="API Sunucu Bağlantısı" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,25"/>
                                    <Border Background="#1E293B" CornerRadius="12" Padding="25" BorderBrush="#334155" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Sunucu Adresi" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,8"/>
                                            <TextBox x:Name="txtApiUrl" FontSize="14" Padding="12" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" Text="http://10.40.80.167:5000/api" Margin="0,0,0,15"/>
                                            <Grid Margin="0,5,0,20">
                                                <TextBlock Text="Bağlantı Durumu:" Foreground="#94A3B8"/>
                                                <TextBlock Text="🔴 Bağlı Değil" Foreground="#EF4444" FontWeight="Bold" HorizontalAlignment="Right" x:Name="txtApiStatus"/>
                                            </Grid>
                                            <UniformGrid Columns="3">
                                                <Button Click="BtnTestApi_Click" Style="{StaticResource RoundedButton8}" Content="Test Et" Background="#334155" Foreground="White" Padding="10,12" Margin="0,0,5,0" Cursor="Hand"/>
                                                <Button Style="{StaticResource RoundedButton8}" Content="Bağlan" Background="#10B981" Foreground="White" Padding="10,12" Margin="5,0,5,0" FontWeight="Bold" Cursor="Hand"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </TabItem>
                            <TabItem>
                                <StackPanel Margin="40,30,40,0" HorizontalAlignment="Left" Width="450">
                                    <TextBlock Text="Arduino Donanım Kontrolü" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,25"/>
                                    <Border Background="#1E293B" CornerRadius="12" Padding="25" BorderBrush="#334155" BorderThickness="1">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,20">
                                                <TextBlock Text="Son Veri İletişimi:" Foreground="#94A3B8"/>
                                                <TextBlock Text="14:22:31" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="COM Port" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,8"/>
                                            <ComboBox x:Name="cmbComPort" FontSize="14" Margin="0,0,0,20">
                                                <ComboBoxItem Content="COM3"/>
                                                <ComboBoxItem Content="COM4" IsSelected="True"/>
                                            </ComboBox>
                                            <UniformGrid Columns="3">
                                                <Button Style="{StaticResource RoundedButton8}" Content="Port Tara" Background="#334155" Foreground="White" Padding="10,12" Margin="0,0,5,0" Cursor="Hand"/>
                                                <Button Style="{StaticResource RoundedButton8}" Content="Bağlan" Background="#10B981" Foreground="White" Padding="10,12" Margin="5,0,5,0" FontWeight="Bold" Cursor="Hand"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </TabItem>

                            <!-- İŞTE BURASI: YAZICI VE BİLET AYARLARI SEKMESİ -->
                            <TabItem>
                                <StackPanel Margin="40,30,40,0" HorizontalAlignment="Left" Width="450">
                                    <TextBlock Text="Yazıcı ve Bilet Ayarları" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,25"/>
                                    <Border Background="#1E293B" CornerRadius="12" Padding="25" BorderBrush="#334155" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Varsayılan Termal Yazıcı" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,8"/>
                                            <ComboBox x:Name="cmbPrinters" FontSize="14" Margin="0,0,0,20">
                                                <ComboBoxItem Content="EPSON TM-T20" IsSelected="True"/>
                                                <ComboBoxItem Content="Xprinter XP-58"/>
                                            </ComboBox>

                                            <!-- YENİ EKLENEN ONAY KUTUSU (CHECKBOX) -->
                                            <CheckBox x:Name="chkIsPrintingEnabled" Content="Fiziksel Bilet Yazdırmayı Aktif Et" Foreground="#F8FAFC" FontSize="14" Margin="0,0,0,25" Cursor="Hand" />

                                            <Button Click="BtnPrintTest_Click" Style="{StaticResource RoundedButton8}" Content="Sınama Biletini Yazdır" Background="#F59E0B" Foreground="White" FontWeight="Bold" Padding="20,12" BorderThickness="0" Cursor="Hand"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </TabItem>

                            <TabItem>
                                <StackPanel Margin="40,30,40,0" HorizontalAlignment="Left" Width="450">
                                    <TextBlock Text="SQL Veritabanı Ayarları" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,25"/>
                                    <Border Background="#1E293B" CornerRadius="12" Padding="25" BorderBrush="#334155" BorderThickness="1">
                                        <StackPanel>
                                            <Grid Margin="0,8">
                                                <TextBlock Text="Sunucu:" Foreground="#94A3B8"/>
                                                <TextBlock Text="localhost" HorizontalAlignment="Right" Foreground="#F8FAFC"/>
                                            </Grid>
                                            <Grid Margin="0,8">
                                                <TextBlock Text="Database:" Foreground="#94A3B8"/>
                                                <TextBlock Text="QueueDB" HorizontalAlignment="Right" Foreground="#F8FAFC" FontWeight="Bold"/>
                                            </Grid>
                                            <Grid Margin="0,8">
                                                <TextBlock Text="Son Backup:" Foreground="#94A3B8"/>
                                                <TextBlock Text="22.07.2026" HorizontalAlignment="Right" Foreground="#F8FAFC"/>
                                            </Grid>
                                            <UniformGrid Columns="2" Margin="0,25,0,0">
                                                <Button Click="BtnBackupDb_Click" Style="{StaticResource RoundedButton8}" Content="Yedek Al (Backup)" Background="#3B82F6" Foreground="White" Padding="10,12" Margin="0,0,5,0" FontWeight="Bold" Cursor="Hand"/>
                                                <Button Style="{StaticResource RoundedButton8}" Content="Geri Yükle" Background="#334155" Foreground="White" Padding="10,12" Margin="5,0,0,0" FontWeight="Bold" Cursor="Hand"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                        <Button Click="BtnSaveSettings_Click" Grid.Column="1" Style="{StaticResource RoundedButton8}" Content="Ayarları Sisteme Kaydet" Background="#10B981" Foreground="White" Padding="30,12" FontSize="15" FontWeight="Bold" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,30"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
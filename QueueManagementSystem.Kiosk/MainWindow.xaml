<Window x:Class="QueueManagementSystem.Kiosk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sıra Alma Ekranı" 
        WindowState="Maximized" 
        WindowStyle="None"
        Background="#2C3E50">

    <Grid>
        <!-- Ana Ekran (İşlem Seçimi) -->
        <StackPanel x:Name="pnlSelection" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Hoş Geldiniz" FontSize="48" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Lütfen yapmak istediğiniz işlemi seçin" FontSize="24" Foreground="#BDC3C7" HorizontalAlignment="Center" Margin="0,0,0,50"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Bireysel İşlem" Width="300" Height="150" FontSize="32" FontWeight="Bold" 
                        Background="#3498DB" Foreground="White" Margin="0,0,30,0" BorderThickness="0"
                        Click="BtnBireysel_Click" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Kurumsal İşlem" Width="300" Height="150" FontSize="32" FontWeight="Bold" 
                        Background="#E67E22" Foreground="White" BorderThickness="0"
                        Click="BtnKurumsal_Click" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Bilet Gösterme Ekranı (Başlangıçta Gizli) -->
        <Border x:Name="pnlTicket" Background="White" Width="500" Height="400" CornerRadius="30" 
                Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Bilet Numaranız" FontSize="32" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                <TextBlock x:Name="txtTicketNumber" Text="A00" FontSize="100" FontWeight="Bold" Foreground="#E74C3C" HorizontalAlignment="Center" Margin="0,20"/>
                <TextBlock Text="Lütfen ekrandan sıranızı takip edin." FontSize="20" Foreground="#95A5A6" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>